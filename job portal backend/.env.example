# Job Portal Backend environment
# Copy to .env and fill in values

# PostgreSQL required. Azure production URLs must include sslmode=require.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# "auto" detects Neon's -pooler hostname and uses serverless/NullPool mode,
# avoiding persistent Railway connections and one pre-ping query per request.
# Dedicated PostgreSQL automatically uses a small LIFO SQLAlchemy QueuePool.
DB_POOL_MODE=auto
# Set to require for Azure PostgreSQL; leave empty for local Docker PostgreSQL.
DB_SSLMODE=

# Infrastructure Analytics capacity and cost tracking
# Storage totals are dashboard budgets/allocations, not artificial provider limits.
DB_STORAGE_LIMIT_GB=32
R2_STORAGE_LIMIT_GB=10
BACKEND_CPU_LIMIT_CORES=0.5
BACKEND_MEMORY_LIMIT_MB=1024
BACKEND_MIN_REPLICAS=0
BACKEND_MAX_REPLICAS=2
BACKEND_PROVIDER=Railway Serverless
BACKEND_RUNTIME_MODEL=Serverless
DATABASE_PROVIDER=Neon Postgres
FRONTEND_PLAN=Free
FRONTEND_APP_LIMIT_MB=250
FRONTEND_BANDWIDTH_LIMIT_GB=100
INFRA_MONTHLY_BUDGET_USD=25
# Railway Free is $0/month with $1 of resource usage. Crossing that credit
# requires waiting for the next billing reset or upgrading to Hobby ($5/month).
# The *_CURRENT_* variables can be copied from Railway Workspace > Usage until
# a stable account-billing API is available to the service.
RAILWAY_SUBSCRIPTION_PLAN=Free
RAILWAY_SUBSCRIPTION_FEE_USD=0
RAILWAY_INCLUDED_USAGE_USD=1
RAILWAY_CURRENT_USAGE_USD=
RAILWAY_PROJECTED_USAGE_USD=
RAILWAY_CPU_VCPU_HOURS=
RAILWAY_MEMORY_GB_HOURS=
RAILWAY_NETWORK_EGRESS_GB=
RAILWAY_VOLUME_GB_MONTHS=
RAILWAY_BILLING_PERIOD_START=
RAILWAY_BILLING_PERIOD_END=
# Legacy actual-cost override remains supported.
RAILWAY_MONTH_TO_DATE_COST_USD=
NEON_PLAN=Free
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_COMPUTE_CU_HOURS=
NEON_HISTORY_STORAGE_GB=
NEON_NETWORK_TRANSFER_GB=
NEON_BRANCH_COUNT=
NEON_BILLING_PERIOD_START=
NEON_BILLING_PERIOD_END=
RESEND_PLAN=Free
RESEND_MONTHLY_EMAIL_LIMIT=3000
RESEND_DAILY_EMAIL_LIMIT=100
RESEND_SUBSCRIPTION_FEE_USD=0
RESEND_BILLING_PERIOD_START=
RESEND_BILLING_PERIOD_END=
R2_CLASS_A_OPERATIONS=
R2_CLASS_B_OPERATIONS=
R2_BILLING_PERIOD_START=
R2_BILLING_PERIOD_END=
CLOUDFLARE_API_TOKEN=
FRONTEND_MONTHLY_COST_USD=
FRONTEND_APP_SIZE_MB=
FRONTEND_BANDWIDTH_USED_GB=
AZURE_PROJECTED_COST_USD=
# Month in which the current Railway + Neon stack started. Railway and Neon are
# known to be $0 before this month; use the invoice backfill below for the
# providers that hosted the site before cutover.
INFRA_CURRENT_STACK_STARTED_MONTH=2026-08
INFRA_COST_HISTORY_MONTHS=12
# Current-month invoice/payment amount already settled. The dashboard headline
# subtracts this from the current billed/estimated amount.
INFRA_CURRENT_MONTH_PAID_USD=0
INFRA_FORECAST_MONTHLY_COST_USD=
# Optional invoice backfill:
# [{"month":"2026-07","provider_costs":{"Railway":0,"Neon":0,"Microsoft Azure":0,"Cloudflare R2":0}}]
# Example:
# {"2026-07":{"provider_costs":{"Microsoft Azure":12.30},"paid_usd":12.30}}
INFRA_COST_HISTORY_JSON=
# Optional retained-Azure live cost access. The current dashboard intentionally
# includes only Azure Static Web Apps from Azure Cost Management.
AZURE_COST_MANAGEMENT_ENABLED=false
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_MANAGED_RESOURCE_GROUP=

LOG_LEVEL=INFO
# R2 error/lifecycle logs are intentionally production-only. CI/CD enables
# these on Azure; leave disabled for local Docker development.
APP_ENV=local
R2_LOGS_ENABLED=false
R2_LOG_PREFIX=production-logs
R2_LOG_MAX_BYTES=104857600
R2_LOG_RETENTION_DAYS=2
SEED_ON_STARTUP=false
QWEN3_EMBEDDING_CACHE_BACKGROUND=true
# Destructive and normally unset. Never enable without a verified database backup.
RESET_DB_SCHEMA=false

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-at-least-12-characters
MAX_FAILED_LOGIN_ATTEMPTS=3
ADMIN_RECOVERY_EMAIL=hussam.cheema7102@gmail.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_IP_HOUR=5
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=10

# Email delivery. Railway Hobby blocks outbound SMTP, so production should use
# Resend's HTTPS API. SMTP remains available for local/Pro environments.
EMAIL_DELIVERY_PROVIDER=auto
EMAIL_FROM_EMAIL=
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
EMAIL_HTTP_TIMEOUT_SECONDS=20
# SMTP used for admin recovery and as an optional delivery fallback.
# For Gmail, use an App Password rather than the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hussam.cheema7102@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hussam.cheema7102@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
SMTP_SEND_ATTEMPTS=3
# Failed recipients are retained in the database and retried automatically.
NEWSLETTER_MAX_DELIVERY_ATTEMPTS=5
NEWSLETTER_RETRY_INTERVAL_SECONDS=60
NEWSLETTER_RETRY_ENABLED=true
# Enable for only the short final database-copy window. Public GET requests
# continue normally while all writes receive a retryable HTTP 503.
WRITE_FREEZE_ENABLED=false

# Site (overrides config.yaml site.url when set)
SITE_URL=http://localhost:3000
# Public backend origin used for RFC 8058 one-click unsubscribe requests.
PUBLIC_API_URL=http://localhost:8000
SITE_NAME=Pakistan Jobs Market
WATERMARK_TEXT=
WATERMARK_OPACITY=0.32

# Cloudflare R2 (S3-compatible API)
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=job-portal
# Optional explicit override; normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Public R2 custom domain, for example https://files.example.com
R2_PUBLIC_BASE_URL=

# YouTube
YOUTUBE_API_KEY=

# LLM providers (enable matching provider in config.yaml)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional overrides for captionless YouTube audio transcription. By default
# this reuses OPENAI_API_KEY and OPENAI_BASE_URL.
OPENAI_TRANSCRIPTION_BASE_URL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Persistent Qwen3-Embedding-0.6B fallback. In Azure, /models must be an Azure Files mount.
# Optional override. Leave empty to use config.yaml (OpenAI, then Qwen3 fallback).
EMBEDDING_PROVIDER=
QWEN3_EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B-Q8_0.gguf
QWEN3_EMBEDDING_MODEL_MOUNT_PATH=/models
QWEN3_EMBEDDING_REQUIRE_PERSISTENT_STORAGE=false
QWEN3_EMBEDDING_THREADS=1
# Optional for private/rate-limited Hugging Face downloads.
HF_TOKEN=
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
META_API_KEY=
META_BASE_URL=https://api.together.xyz/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Independent diagnostic scripts
API_BASE_URL=http://localhost:8000
TEST_JOB_POST_ID=

# SEO tools (optional free Google APIs)
# PAGESPEED_API_KEY=   # Google PageSpeed Insights API key for real 0-100 score
# GSC_SITE_URL=https://www.example.com/
# Preferred on Railway/serverless hosts: paste the complete service-account
# JSON as a secret environment variable.
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Alternative for hosts that mount a secret file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
