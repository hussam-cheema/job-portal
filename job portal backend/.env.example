# Job Portal Backend environment
# Copy to .env and fill in values

# PostgreSQL required. Azure production URLs must include sslmode=require.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# Set to require for Azure PostgreSQL; leave empty for local Docker PostgreSQL.
DB_SSLMODE=

LOG_LEVEL=INFO
SEED_ON_STARTUP=false
# Destructive and normally unset. Never enable without a verified database backup.
RESET_DB_SCHEMA=false

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-at-least-12-characters
MAX_FAILED_LOGIN_ATTEMPTS=3
ADMIN_RECOVERY_EMAIL=hussam.cheema7102@gmail.com
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_IP_HOUR=5
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=10

# SMTP used for admin recovery and the daily subscriber digest.
# For Gmail, use an App Password rather than the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hussam.cheema7102@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hussam.cheema7102@gmail.com
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15

# Scheduler secret. Put the same value in the GitHub production secret DAILY_DIGEST_TOKEN.
DAILY_DIGEST_TOKEN=

# Site (overrides config.yaml site.url when set)
SITE_URL=http://localhost:3000
SITE_NAME=PakJobs
WATERMARK_TEXT=
WATERMARK_OPACITY=0.32

# Cloudflare R2 (S3-compatible API)
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=job-portal
# Optional explicit override; normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Public R2 custom domain, for example https://files.example.com
R2_PUBLIC_BASE_URL=

# YouTube
YOUTUBE_API_KEY=

# LLM providers (enable matching provider in config.yaml)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Persistent Qwen3-Embedding-0.6B fallback. In Azure, /models must be an Azure Files mount.
# Optional override. Leave empty to use config.yaml (OpenAI, then Qwen3 fallback).
EMBEDDING_PROVIDER=
QWEN3_EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B-Q8_0.gguf
QWEN3_EMBEDDING_MODEL_MOUNT_PATH=/models
QWEN3_EMBEDDING_REQUIRE_PERSISTENT_STORAGE=false
QWEN3_EMBEDDING_THREADS=1
# Optional for private/rate-limited Hugging Face downloads.
HF_TOKEN=
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
META_API_KEY=
META_BASE_URL=https://api.together.xyz/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Independent diagnostic scripts
API_BASE_URL=http://localhost:8000
TEST_JOB_POST_ID=

# SEO tools (optional free Google APIs)
# PAGESPEED_API_KEY=   # Google PageSpeed Insights API key for real 0-100 score
# GSC_SITE_URL=https://www.example.com/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
