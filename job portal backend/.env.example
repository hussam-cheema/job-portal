# Job Portal Backend environment
# Copy to .env and fill in values

# PostgreSQL required. Azure production URLs must include sslmode=require.
# URL-encode special characters in the username/password.
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
# Set to require for Azure PostgreSQL; leave empty for local Docker PostgreSQL.
DB_SSLMODE=

# Infrastructure Analytics capacity and cost tracking
# Storage totals are dashboard budgets/allocations, not artificial provider limits.
DB_STORAGE_LIMIT_GB=32
R2_STORAGE_LIMIT_GB=10
BACKEND_CPU_LIMIT_CORES=0.5
BACKEND_MEMORY_LIMIT_MB=1024
BACKEND_MIN_REPLICAS=0
BACKEND_MAX_REPLICAS=2
FRONTEND_PLAN=Free
FRONTEND_APP_LIMIT_MB=250
FRONTEND_BANDWIDTH_LIMIT_GB=100
INFRA_MONTHLY_BUDGET_USD=25
# Populate these from Azure Cost Management for a complete tracked estimate.
DB_MONTHLY_COST_USD=
BACKEND_MONTHLY_COST_USD=
FRONTEND_MONTHLY_COST_USD=

LOG_LEVEL=INFO
SEED_ON_STARTUP=false
# Destructive and normally unset. Never enable without a verified database backup.
RESET_DB_SCHEMA=false

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-at-least-12-characters

# Site (overrides config.yaml site.url when set)
SITE_URL=http://localhost:3000
SITE_NAME=PakJobs
WATERMARK_TEXT=
WATERMARK_OPACITY=0.10

# Cloudflare R2 (S3-compatible API)
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=job-portal
# Optional explicit override; normally derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Public R2 custom domain, for example https://files.example.com
R2_PUBLIC_BASE_URL=

# YouTube
YOUTUBE_API_KEY=

# LLM providers (enable matching provider in config.yaml)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
META_API_KEY=
META_BASE_URL=https://api.together.xyz/v1
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Independent diagnostic scripts
API_BASE_URL=http://localhost:8000
TEST_JOB_POST_ID=

# SEO tools (optional free Google APIs)
# PAGESPEED_API_KEY=   # Google PageSpeed Insights API key for real 0-100 score
# GSC_SITE_URL=https://www.example.com/
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
