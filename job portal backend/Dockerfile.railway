# syntax=docker/dockerfile:1
FROM python:3.12-slim AS wheels

ENV CMAKE_ARGS="-DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DGGML_BLAS=OFF"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --upgrade pip && pip wheel --wheel-dir /wheels -r requirements.txt

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LOG_LEVEL=INFO \
    SEED_ON_STARTUP=false \
    PORT=8000 \
    WEB_CONCURRENCY=1 \
    QWEN3_EMBEDDING_MODEL_PATH=/models/Qwen3-Embedding-0.6B-Q8_0.gguf \
    QWEN3_EMBEDDING_MODEL_MOUNT_PATH=/models \
    QWEN3_EMBEDDING_REQUIRE_PERSISTENT_STORAGE=false \
    QWEN3_EMBEDDING_CACHE_BACKGROUND=true \
    QWEN3_EMBEDDING_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    libreoffice-writer \
    fontconfig \
    fonts-dejavu-core \
    fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheels /wheels /wheels
RUN pip install --no-index --find-links=/wheels /wheels/* && rm -rf /wheels

COPY app ./app
COPY migration ./migration
COPY config.yaml ./config.yaml
COPY .env.example ./.env.example

# Bake the public fallback embedding into the immutable image. This avoids a
# Railway volume (which prevents clean overlapping deploys) and prevents a new
# revision from downloading 600+ MB before its first Q&A request.
RUN python -m app.services.model_cache

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/ready" || exit 1

# Keep this shell form: Railway injects PORT at runtime and exec form would
# otherwise pass the literal variable name to Uvicorn.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-1}"]
